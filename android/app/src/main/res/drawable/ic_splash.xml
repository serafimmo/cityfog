<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <!-- Та же композиция, что и у иконки приложения, масштабированная в холст SplashScreen.
         Центр арта (54,52) переносится в центр холста (144,144). -->
    <group
        android:scaleX="2.6"
        android:scaleY="2.6"
        android:pivotX="54"
        android:pivotY="52"
        android:translateX="90"
        android:translateY="92">

        <!-- Тусклая сетка неоткрытых клеток. -->
        <path
            android:strokeColor="#22D3EE"
            android:strokeWidth="0.8"
            android:strokeAlpha="0.13"
            android:pathData="M30,28v48 M42,28v48 M54,28v48 M66,28v48 M78,28v48
                              M30,28h48 M30,40h48 M30,52h48 M30,64h48 M30,76h48" />

        <!-- Далёкие открытые клетки. -->
        <path android:fillColor="#22D3EE" android:fillAlpha="0.20"
            android:pathData="M30,28h12v12h-12z" />
        <path android:fillColor="#22D3EE" android:fillAlpha="0.20"
            android:pathData="M66,64h12v12h-12z" />

        <!-- Плюс открытых клеток. -->
        <path android:fillColor="#22D3EE" android:fillAlpha="0.55"
            android:pathData="M48,34h12v12h-12z" />
        <path android:fillColor="#22D3EE" android:fillAlpha="0.55"
            android:pathData="M48,58h12v12h-12z" />
        <path android:fillColor="#22D3EE" android:fillAlpha="0.55"
            android:pathData="M36,46h12v12h-12z" />
        <path android:fillColor="#22D3EE" android:fillAlpha="0.55"
            android:pathData="M60,46h12v12h-12z" />

        <!-- Центральная горячая клетка. -->
        <path android:pathData="M48,46h12v12h-12z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="48" android:startY="46"
                    android:endX="60" android:endY="58"
                    android:startColor="#5EEAFB"
                    android:endColor="#16C0D4" />
            </aapt:attr>
        </path>

        <!-- Ореол и точка позиции. -->
        <path android:fillColor="#22D3EE" android:fillAlpha="0.16"
            android:pathData="M54,52m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0" />
        <path android:fillColor="#22D3EE" android:fillAlpha="0.30"
            android:pathData="M54,52m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
        <path android:fillColor="#ECFEFF"
            android:pathData="M54,52m-3.8,0a3.8,3.8 0,1 1,7.6 0a3.8,3.8 0,1 1,-7.6 0" />
    </group>
</vector>
